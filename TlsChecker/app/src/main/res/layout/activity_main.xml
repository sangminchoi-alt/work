<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TLS Checker — BFX-UA300"
        android:textColor="#e0e0ff"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="테스트 호스트 (예: tls13.cloudflare.com)"
            android:textColorHint="#888"
            android:textColor="#ffffff"
            android:backgroundTint="#444466"
            android:padding="10dp"
            android:inputType="textUri"
            android:text="tls13.cloudflare.com" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="Port"
            android:textColorHint="#888"
            android:textColor="#ffffff"
            android:backgroundTint="#444466"
            android:padding="10dp"
            android:inputType="number"
            android:text="443"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="검사 시작"
            android:backgroundTint="#4f46e5"
            android:textColor="#ffffff"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="복사"
            android:backgroundTint="#374151"
            android:textColor="#ffffff"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="지우기"
            android:backgroundTint="#374151"
            android:textColor="#ffffff"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#0d0d1a"
        android:padding="2dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#00ff88"
            android:textSize="13sp"
            android:padding="10dp"
            android:lineSpacingMultiplier="1.3"
            android:text="[대기 중] 검사 시작 버튼을 눌러주세요.\n" />

    </ScrollView>

</LinearLayout>
